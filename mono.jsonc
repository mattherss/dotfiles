// Inspired by microfetch
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small"
    },
    "general": {
        "detectVersion": false
    },
    "display": {
        "separator": "  ",
        "brightColor": false,
        "key": {
            "type": "both-2"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}{#white}@{host-name} {#}{cwd}",
	    "keyColor": "white"
        },
        {
            "type": "os",
	    "keyColor": "white",
            "key": "System       "
        },
        {
            "type": "kernel",
            "key": "Kernel       ",
	    "keyColor": "white"
        },
        {
            "type": "shell",
            "key": "Shell        ",
	    "keyColor": "white"
        },
        {
            "type": "uptime",
            "key": "Uptime       ",
	    "keyColor": "white"
        },
        {
            "type": "wm",
            "key": "Desktop      ",
	    "keyColor": "white"
        },
        {
            "type": "memory",
            "key": "Memory       ",
	    "keyColor": "white"
        },
        {
            "type": "disk",
            "key": "Storage (/)  ",
            "folders": "/",
	    "keyColor": "white"
        },
    ]
}
